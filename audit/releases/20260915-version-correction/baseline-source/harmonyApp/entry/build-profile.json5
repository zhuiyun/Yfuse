{
  "apiType": "stageMode",
  "buildOption": {
    "cangjieOptions": {
      "path": "./src/main/cangjie/cjpm.toml",
      "abiFilters": ["arm64-v8a", "x86_64"]
    },
    "nativeLib": {
      "filter": {
        "enableOverride": true
      }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-std=c++17 -Wall -Wextra -Wpedantic"
    }
  },
  "buildOptionSet": [
    { "name": "release", "arkOptions": { "obfuscation": { "ruleOptions": { "enable": true } } } }
  ],
  "targets": [
    { "name": "default" }
  ]
}
