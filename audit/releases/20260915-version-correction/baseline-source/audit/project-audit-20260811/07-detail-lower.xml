e" password="false" selected="false" bounds="[91,47][637,348]" /></node><node index="1" text="第1集 · 百人部队深夜离奇失踪" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,373][637,432]" /><node index="2" text="长沙军备医院，护士徐媛夜巡时发现本应在城外施工的401部队竟全员出现在大厅。12点08分，401部队连同院内所有人离奇消失。长沙布防官张启山赶到，发现地下的山体被掏空，尽头是一堵数百米厚的人工巨墙，401部队痕迹至此切断。齐铁嘴判断墙体为阳宅结构，强拆必塌，唯有吴老狗的犬可破机关。张吴两家有仇，齐铁嘴硬着头皮上门求援。张启山则在废弃砖窑发现当年窑工的尸体竟然排成了倒八卦阵，墙上还留着挑衅的字迹。" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,443][637,501]" /><node index="3" text="39 分钟" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[91,515][229,573]" /><node index="4" text="" resource-id="" class="android.widget.Button" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,19][665,601]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[700,19][1302,601]"><node index="0" text="" resource-id="" class="android.view.View" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[728,47][1274,348]"><node index="0" text="" resource-id="" class="android.view.View" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[728,47][1274,348]" /></node><node index="1" text="第2集 · 张启山和吴老狗达成合作" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[728,373][1274,432]" /><node index="2" text="张启山与吴老狗会面，吴老狗扔出尹新月的二响环，逼他在“救妻”与“救兵”间二选一。张启山制伏吴老狗后选择谈判，吴老狗开出条件，要张启山事成后退出九门，张启山应允。尹新月自行逃脱，痛揍吴老狗后安然返回。霍仙姑因家族债务，被迫答应丁千岁充当眼线，监视张启山的探查行动。地下平台，失踪的401部队士兵从墙洞现身与守卫诡异换防，钟表再次指向12点08分。" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[728,443][1274,501]" /><node index="3" text="39 分钟" resource-id="" class="android.widget.TextView" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[728,515][866,573]" /><node index="4" text="" resource-id="" class="android.widget.Button" package="com.yfuse" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[700,19][1302,601]" /></node><node index="2" text="" resource-id="" class="android.view.View" packa