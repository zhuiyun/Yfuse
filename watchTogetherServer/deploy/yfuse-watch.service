[Unit]
Description=Yfuse update and watch-together server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/srv/yfuse-update
Environment=PORT=80
Environment=UPDATE_ROOT=/srv/yfuse-update/yfuse
Environment="JAVA_OPTS=-Xms32m -Xmx128m"
ExecStart=/opt/yfuse-watch/current/bin/watchTogetherServer
Restart=on-failure
RestartSec=3
SuccessExitStatus=143
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/yfuse-update /opt/yfuse-watch

[Install]
WantedBy=multi-user.target
