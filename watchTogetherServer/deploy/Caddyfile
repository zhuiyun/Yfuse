{
	# Some TLS stacks omit SNI when connecting to an IPv4 literal. Select the
	# public IP certificate in that case so https://47.112.219.60 remains usable.
	default_sni 47.112.219.60
}

# Preferred endpoint for the app. Let's Encrypt IP certificates use its
# short-lived profile (160 hours); Caddy renews them automatically.
https://47.112.219.60 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	@account path /api/*
	header @account Cache-Control "no-store"

	reverse_proxy 127.0.0.1:8080 {
		# Avoid dropping every active watch room immediately on a config reload.
		stream_close_delay 5m
	}
}

# Domain entry point. It remains available after ICP/access filing is complete.
yfuse.zhuiyun.site {
	# Conservative first-rollout value. Raise to 31536000 after DNS, certificate,
	# and deployment behavior have remained stable.
	header Strict-Transport-Security "max-age=86400"
	@account path /api/*
	header @account Cache-Control "no-store"

	reverse_proxy 127.0.0.1:8080 {
		# Avoid dropping every active watch room immediately on a config reload.
		stream_close_delay 5m
	}
}

# Temporary compatibility path for already-published clients whose update
# endpoint is the historical HTTP URL. Account APIs and watch-room sockets reject
# this transport; remove this block after those client versions have aged out.
http://47.112.219.60 {
	@account path /api/*
	header @account Content-Type "application/json; charset=utf-8"
	header @account Cache-Control "no-store"
	header @account Pragma "no-cache"
	respond @account `{"error":{"code":"https_required","message":"账号接口仅接受 HTTPS 请求"}}` 426

	@watch path /watch
	header @watch Content-Type "application/json; charset=utf-8"
	header @watch Cache-Control "no-store"
	header @watch Pragma "no-cache"
	respond @watch `{"error":{"code":"https_required","message":"一起看仅接受 WSS 连接"}}` 426

	reverse_proxy 127.0.0.1:8080 {
		stream_close_delay 5m
	}
}
