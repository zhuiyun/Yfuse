[Unit]
Description=Yfuse legacy loopback-only static update server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/srv/yfuse-update
# The production Caddyfile proxies the combined Ktor service on 8080 instead.
# Keep this legacy server loopback-only if an installation still serves updates separately.
ExecStart=/usr/bin/python3 -m http.server 8081 --bind 127.0.0.1
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 15 --retry-connrefused --retry-delay 1 --retry-max-time 15 --connect-timeout 1 http://127.0.0.1:8081/yfuse/update.json
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
LimitNOFILE=4096
TasksMax=64
MemoryHigh=96M
MemoryMax=128M
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/srv/yfuse-update

[Install]
WantedBy=multi-user.target
