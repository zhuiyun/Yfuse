<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_title" android:textColor="#BDBDBD" android:textSize="12sp" />
    <TextView android:id="@+id/widget_resume" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:minHeight="48dp"
        android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#BDBDBD" android:textSize="12sp" />
    <TextView android:id="@+id/widget_follow" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
