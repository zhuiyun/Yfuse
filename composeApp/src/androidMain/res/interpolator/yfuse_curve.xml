<?xml version="1.0" encoding="utf-8"?>
<!-- Motion.Curve, cubic-bezier(.32,.72,0,1): the app's own easing, for the windows the system
     animates. The platform's fast_out_slow_in arrived on a different curve from everything drawn
     inside them. -->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.32"
    android:controlY1="0.72"
    android:controlX2="0"
    android:controlY2="1" />
