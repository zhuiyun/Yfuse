<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Self-hosted Emby / Plex servers are routinely reached over plain HTTP on a LAN or through a
        tunnel that terminates TLS elsewhere, so cleartext stays allowed for user-entered origins.
    -->
    <base-config cleartextTrafficPermitted="true" />
    <!--
        Network Security Configuration matches hosts, not ports. Do not put the shared
        47.112.219.60 host here: its user-configured media service uses HTTP on port 19001.
        AccountApi, AccountAccessTokenSource and the update source/download policy enforce
        HTTPS for official services independently of this media-server compatibility setting.
        Metadata providers and the Plex account service remain TLS-only at the platform layer.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <domain includeSubdomains="true">trakt.tv</domain>
        <domain includeSubdomains="true">plex.tv</domain>
    </domain-config>
</network-security-config>
