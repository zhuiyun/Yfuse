<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Users may explicitly connect to arbitrary self-hosted HTTP Emby servers, including LAN
      hosts that cannot be enumerated here. Keep cleartext explicit for those user-managed
      services, while requiring HTTPS for Yfuse's public services and TMDB.
    -->
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">47.112.219.60</domain>
        <domain includeSubdomains="true">yfuse.zhuiyun.site</domain>
        <domain includeSubdomains="true">themoviedb.org</domain>
    </domain-config>
</network-security-config>
