<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      allowBackup is disabled in the manifest. Keep these exclusions as defense in depth for
      Android 12+ device-transfer implementations: yfuse.xml contains Emby access tokens,
      stable device ids, and other session-bearing preferences.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="yfuse.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yfuse.xml" />
    </device-transfer>
</data-extraction-rules>
