<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      样式在资源限定符之间是「整体替换」而不是「逐条合并」:values-v31 以前重新声明
      Theme.Yfuse,就把 windowBackground 整条丢掉了。所以这里只保留 values 和
      values-night 两份,两份除 parent 外必须逐字相同,所有会随深浅变的值一律走
      @color / @bool 限定符。新增条目请同时改两份。

      windowSplashScreen*(API 31)和 windowLayoutInDisplayCutoutMode(API 27)写在基础
      目录里:旧系统会忽略不认识的主题条目,这样就不用再开 -v27 / -v31 目录。
    -->
    <style name="Theme.Yfuse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_status_bar</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!--
          图标是全透明的:开屏图形由 Compose 画,系统开屏只负责底色。时长设 0,系统就在
          首帧画出来的瞬间交棒,而不是先白等 300ms。
        -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_surface</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
    </style>

    <style name="Theme.Yfuse.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
