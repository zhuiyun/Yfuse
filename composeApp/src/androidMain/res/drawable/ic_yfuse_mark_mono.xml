<?xml version="1.0" encoding="utf-8"?>
<!--
  单色层 —— 设计稿 `mark9Mono`：双弧 + 播放头，同一个墨色，黑白底通吃。

  Android 13+ 的主题化图标只取这一层的 alpha 通道、颜色由系统按壁纸配色替换，所以这里
  写死白色即可；关键是**不能**带 #05070C 的图标壳，壳由系统自己画。几何与
  `ic_yfuse_mark` 完全一致（含 0.70 的安全区缩放），只是所有笔画收成一个颜色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <group
        android:pivotX="100"
        android:pivotY="100"
        android:scaleX="0.70"
        android:scaleY="0.70">

        <path
            android:pathData="M31.53,85.45 A70,70 0 0 1 168.47,85.45"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeLineCap="round" />

        <path
            android:pathData="M168.47,114.55 A70,70 0 0 1 31.53,114.55"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeLineCap="round" />

        <path
            android:pathData="M82,70 L137,100 L82,130 Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="13"
            android:strokeLineJoin="round" />
    </group>
</vector>
