<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标底层。4a 本身不带底板，但 launcher 必须有背景层，
  浅色玻璃底，和全屏开屏页保持一致；在浅色与深色桌面上都保留柔和边界。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FBFCFF" />
                <item android:offset="0.54" android:color="#F0F4FF" />
                <item android:offset="1" android:color="#E1E9FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
