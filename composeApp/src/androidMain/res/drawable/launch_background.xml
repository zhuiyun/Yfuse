<?xml version="1.0" encoding="utf-8"?>
<!--
  亮色开屏底 —— 设计稿 9c 的画框底色 #F7F8FB，和 Compose 开屏第一帧同色，交接时不跳。
  168dp 的方框让标识 ink 落到约 110dp，与 Compose 侧 132dp 舞台里的 108dp 基本对齐。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F8FB" />
        </shape>
    </item>
    <item
        android:width="168dp"
        android:height="168dp"
        android:gravity="center"
        android:drawable="@drawable/ic_yfuse_mark" />
</layer-list>
